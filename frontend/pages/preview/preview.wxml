<view class="preview-wrap">
  <view class="panel backend-panel">
    <view class="panel-head">
      <view>
        <view class="panel-title">后端状态</view>
        <view class="panel-subtitle">当前 {{phaseKey}} · 场景 {{sceneNameText}}</view>
      </view>
      <view class="phase-chip {{phaseCanDownload ? 'done' : (phaseCanViewer ? 'running' : 'pending')}}">{{pipelineRunningText}}</view>
    </view>

    <view class="phase-list">
      <block wx:for="{{backendPhases}}" wx:key="key">
        <view class="phase-card {{item.statusClass}}">
          <view class="phase-card-main">
            <view class="phase-card-title">{{item.title}}</view>
            <view class="phase-card-detail">{{item.detail}}</view>
          </view>
          <view class="phase-card-state">{{item.state}}</view>
        </view>
      </block>
    </view>

    <view class="updated-at">最近刷新：{{lastUpdatedAt}}</view>
    <view class="error-tip" wx:if="{{backendError}}">{{backendError}}</view>
  </view>

  <view class="panel viewer-panel">
    <view class="panel-title">点云查看链接</view>
    <view class="viewer-actions">
      <button class="copy-btn copy-main" bindtap="copyViewerUrl">复制 Viewer 链接</button>
      <button class="copy-btn copy-secondary" bindtap="copyDownloadsUrl">复制下载页</button>
      <button class="copy-btn copy-secondary" bindtap="copyOptimizedLatestPointCloudUrl">复制优化点云</button>
      <button class="copy-btn copy-secondary" bindtap="copyGaussianZipUrl">复制 ZIP</button>
    </view>
    <view class="compact-note">小程序不内嵌 WebView，复制后用浏览器打开。</view>
  </view>

  <view class="panel refresh-panel">
    <button class="refresh-wide" bindtap="refreshNow" loading="{{isRefreshing}}">
      {{isRefreshing ? "刷新中" : "刷新后端状态"}}
    </button>
  </view>

  <view class="panel metrics-panel">
    <view class="panel-title">Gaussian 进度</view>
    <view class="metrics-grid">
      <view class="metric-item">
        <text class="metric-label">Step</text>
        <text class="metric-value">{{pipelineStepText}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-label">进度</text>
        <text class="metric-value">{{pipelinePercentText}}</text>
      </view>
      <view class="metric-item">
        <text class="metric-label">Loss</text>
        <text class="metric-value">{{pipelineLossText}}</text>
      </view>
    </view>
    <view class="metric-foot">上传 {{uploadedImagesText}} 张 · {{uploadStatsText}}</view>
  </view>

  <view class="panel action-panel">
    <view class="panel-title">管理动作</view>
    <input
      class="token-input"
      type="text"
      placeholder="DASHBOARD_AUTH_TOKEN（未启用可留空）"
      value="{{dashboardToken}}"
      bindinput="onDashboardTokenInput"
    />
    <view class="action-row two-actions">
      <button class="action-btn action-export" bindtap="exportLatestGaussian" disabled="{{isActionRunning}}">
        点云导出
      </button>
      <button class="action-btn action-stop" bindtap="stopPipeline" disabled="{{isActionRunning}}">
        停止训练
      </button>
    </view>
    <view class="action-tip" wx:if="{{actionMessage}}">{{actionMessage}}</view>
  </view>

  <view class="panel jobs-panel">
    <view class="panel-title">任务队列</view>
    <view class="jobs-summary">{{jobsSummaryText}}</view>
    <view class="error-tip" wx:if="{{jobsError}}">{{jobsError}}</view>

    <view wx:if="{{jobList.length > 0}}" class="job-list">
      <block wx:for="{{jobList}}" wx:key="id">
        <view class="job-item {{item.statusClass}}">
          <view class="job-main">
            <view class="job-head">
              <text class="job-id">{{item.id}}</text>
              <text class="job-badge {{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="job-meta">图片 {{item.imageText}} 张 · 场景 {{item.sceneText}}</view>
            <view class="job-meta">更新时间：{{item.updatedAt}}</view>
            <view class="job-message" wx:if="{{item.message}}">{{item.message}}</view>
          </view>
          <button
            class="job-cancel"
            data-id="{{item.id}}"
            bindtap="cancelJob"
            disabled="{{!item.canCancel || isActionRunning}}"
          >
            取消
          </button>
        </view>
      </block>
    </view>

    <view wx:else class="empty-tip compact">暂无队列任务</view>
  </view>

  <view class="panel logs-panel">
    <view class="panel-title">后端最新日志</view>
    <view wx:if="{{latestLogLines.length > 0}}" class="log-list">
      <block wx:for="{{latestLogLines}}" wx:key="id">
        <view class="log-line">{{item.text}}</view>
      </block>
    </view>
    <view wx:else class="empty-tip compact">暂无日志</view>
  </view>

  <view class="panel pointcloud-panel">
    <view class="panel-title">点云下载</view>
    <view class="pointcloud-summary">{{pointcloudSummaryText}}</view>
    <view class="error-tip" wx:if="{{pointcloudError}}">{{pointcloudError}}</view>

    <view wx:if="{{pointcloudList.length > 0}}" class="pointcloud-list">
      <block wx:for="{{pointcloudList}}" wx:key="id">
        <view class="pointcloud-item">
          <view class="pointcloud-head">
            <text class="pointcloud-name">{{item.name}}</text>
            <text class="pointcloud-badge {{item.variant === 'gaussian' ? 'badge-gaussian' : ''}}">{{item.typeText}}</text>
          </view>
          <view class="pointcloud-meta">时间：{{item.mtime}}</view>
          <view class="pointcloud-meta">大小：{{item.sizeText}}</view>
          <view class="pointcloud-meta">场景：{{item.scene}}</view>
          <view class="pointcloud-meta">类型：{{item.typeText}}</view>
          <view class="pointcloud-path">{{item.pathText}}</view>
          <view class="pointcloud-actions">
            <button class="mini-copy-btn" data-url="{{item.optimizedUrl}}" bindtap="copyPointcloudDownloadUrl">优化链接</button>
            <button class="mini-copy-btn" data-url="{{item.rawUrl}}" bindtap="copyPointcloudRawUrl">原始链接</button>
            <button class="mini-copy-btn" data-url="{{item.zipUrl}}" bindtap="copyPointcloudZipUrl">ZIP</button>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="empty-tip">
      暂无可下载点云。训练完成或手动导出 Gaussian 后会显示在这里。
    </view>
  </view>

  <view class="copy-state" wx:if="{{copiedLabel}}">已复制：{{copiedLabel}}</view>
  <button bindtap="goBack" class="back-btn">返回采集页</button>
</view>
