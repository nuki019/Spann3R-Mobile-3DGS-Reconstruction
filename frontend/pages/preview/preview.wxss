.preview-wrap {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #091019 0%, #111d2c 62%, #202838 100%);
  padding: 20rpx 0 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.panel {
  width: 92%;
  margin: 0 auto 20rpx;
  background-color: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8cc8ff;
  margin-bottom: 12rpx;
}

.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.panel-subtitle,
.compact-note,
.metric-foot,
.updated-at {
  color: #c9d6e6;
  font-size: 22rpx;
  line-height: 1.45;
}

.phase-chip {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #d6e4ff;
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
}

.phase-chip.running,
.phase-card.running .phase-card-state {
  background: rgba(22, 119, 255, 0.22);
  color: #91caff;
}

.phase-chip.done,
.phase-card.done .phase-card-state {
  background: rgba(82, 196, 26, 0.22);
  color: #b7eb8f;
}

.phase-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.phase-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.28);
  border-left: 8rpx solid rgba(255, 255, 255, 0.18);
}

.phase-card.running {
  border-left-color: #1677ff;
}

.phase-card.done {
  border-left-color: #52c41a;
}

.phase-card.warn {
  border-left-color: #faad14;
}

.phase-card-title {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.phase-card-detail {
  margin-top: 6rpx;
  color: #b9c7d9;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
}

.phase-card-main {
  flex: 1;
  min-width: 0;
}

.phase-card-state {
  flex-shrink: 0;
  min-width: 108rpx;
  text-align: center;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  color: #c9d6e6;
  background: rgba(255, 255, 255, 0.12);
  font-size: 22rpx;
}

.viewer-actions,
.download-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.copy-btn,
.back-btn,
.refresh-wide,
.action-btn,
.mini-copy-btn {
  border: none;
  margin: 0;
  color: #fff;
  box-sizing: border-box;
}

.copy-btn,
.refresh-wide,
.back-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.copy-main,
.refresh-wide {
  background-color: #1677ff;
}

.copy-secondary {
  background-color: #31445f;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.metric-item {
  min-height: 104rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: rgba(0, 0, 0, 0.32);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.metric-label {
  color: #b9c7d9;
  font-size: 21rpx;
}

.metric-value {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  word-break: break-all;
}

.token-input {
  width: 100%;
  height: 68rpx;
  border-radius: 12rpx;
  background-color: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.two-actions .action-btn {
  flex: 1;
}

.action-btn {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
}

.action-stop {
  background-color: #a8071a;
}

.action-export {
  background-color: #096dd9;
}

.action-tip {
  margin-top: 12rpx;
  color: #e6f4ff;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.log-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.log-line {
  padding: 12rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.34);
  color: #d7e0ee;
  font-size: 21rpx;
  line-height: 1.45;
  word-break: break-all;
}

.pointcloud-summary {
  background-color: rgba(0, 0, 0, 0.32);
  border-radius: 12rpx;
  color: #e6f4ff;
  font-size: 23rpx;
  line-height: 1.45;
  padding: 14rpx;
  margin-bottom: 14rpx;
  word-break: break-all;
}

.pointcloud-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pointcloud-item {
  background-color: rgba(0, 0, 0, 0.32);
  border-radius: 14rpx;
  padding: 16rpx;
}

.pointcloud-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.pointcloud-name {
  flex: 1;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  word-break: break-all;
}

.pointcloud-badge {
  flex-shrink: 0;
  max-width: 260rpx;
  border-radius: 999rpx;
  background-color: rgba(255, 255, 255, 0.14);
  color: #d6e4ff;
  font-size: 20rpx;
  line-height: 1.35;
  padding: 6rpx 12rpx;
  text-align: center;
}

.badge-gaussian {
  background-color: rgba(82, 196, 26, 0.22);
  color: #b7eb8f;
}

.pointcloud-meta,
.pointcloud-path {
  color: #c9d6e6;
  font-size: 21rpx;
  line-height: 1.5;
  word-break: break-all;
}

.pointcloud-path {
  color: #94a9c2;
  margin-top: 6rpx;
}

.pointcloud-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.mini-copy-btn {
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 12rpx;
  background-color: #1677ff;
  font-size: 21rpx;
}

.empty-tip {
  width: 100%;
  color: #ffec99;
  font-size: 24rpx;
  text-align: center;
  padding: 34rpx 20rpx;
  background-color: rgba(0, 0, 0, 0.25);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.empty-tip.compact {
  padding: 20rpx;
}

.error-tip {
  margin-top: 8rpx;
  background-color: rgba(245, 34, 45, 0.2);
  color: #ffccc7;
  font-size: 22rpx;
  border-radius: 10rpx;
  padding: 12rpx;
  line-height: 1.45;
}

.copy-state {
  margin: 8rpx 0 20rpx;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #fff;
  background-color: rgba(22, 119, 255, 0.75);
}

.back-btn {
  width: 92%;
  background-color: #ff4d4f;
}
