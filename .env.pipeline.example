WATCH_DIR=/workspace/data/input_images
SPANN3R_ROOT=/workspace/Spann3R
DEMO_OUTPUT_ROOT=/workspace/Spann3R/output/demo
TARGET_DATA_DIR=/workspace/data/gs_train/auto_scene
ARCHIVE_DIR=/workspace/data/input_archive

UPLOAD_PORT=6008
VIEWER_PORT=6006
UPLOAD_SAVE_DIR=/workspace/data/input_images
UPLOAD_ALLOW_ORIGINS=*
UPLOAD_AUTH_TOKEN=
UPLOAD_MAX_FILE_SIZE_MB=25
DASHBOARD_AUTH_TOKEN=

MIN_IMG_COUNT=50
STABLE_POLLS=3
POLL_INTERVAL_SEC=5
RETRY_INTERVAL_SEC=15
RUN_ONCE=true
CLEAR_TARGET_BEFORE_RUN=true
ARCHIVE_INPUT=false

SPANN3R_DEVICE=cuda:0
SPANN3R_CKPT_PATH=./checkpoints/spann3r.pth
SPANN3R_CONF_THRESH=0.01
SPANN3R_KF_EVERY=5
SPANN3R_RESOLUTION=224
SPANN3R_VOXEL_SIZE=0.01
SPANN3R_SAVE_ORI=false

TRAIN_SPLIT_FRACTION=0.9
NS_TRAIN_EXTRA_ARGS=
NS_OUTPUT_ROOT=/workspace/Spann3R/outputs
NS_EXPORT_AFTER_TRAIN=true
GAUSSIAN_EXPORT_SUBDIR=gaussian_export
GAUSSIAN_CROP_PADDING_RATIO=0.03
GAUSSIAN_REF_DISTANCE_SCALE=4.0
NS_EXPORT_EXTRA_ARGS=
