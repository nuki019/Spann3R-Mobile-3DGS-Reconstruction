# ===== 路径 =====
WATCH_DIR=/root/autodl-tmp/input_images
SPANN3R_ROOT=/root/autodl-tmp/Spann3R
DEMO_OUTPUT_ROOT=/root/autodl-tmp/Spann3R/output/demo
TARGET_DATA_DIR=/root/autodl-tmp/gs_train/auto_scene
SCENE_DATA_ROOT=/root/autodl-tmp/gs_train/scenes
TEST_PHOTO_ROOT=/root/autodl-tmp/Spann3R/test_photo_sets
SCENE_NAME_PREFIX=scene
ARCHIVE_DIR=/root/autodl-tmp/input_images_archive
UPLOAD_SAVE_DIR=/root/autodl-tmp/input_images

# ===== AutoDL 6006/6008 端口规划 =====
# 6006 固定给 Nerfstudio Viewer。
# 上传服务只监听本机内部端口，经 6008 /upload-proxy 转发到前端。
UPLOAD_INTERNAL_PORT=7006
UPLOAD_PROXY_TARGET=http://127.0.0.1:7006
UPLOAD_PROXY_TIMEOUT_SEC=45
UPLOAD_PORT=7006
VIEWER_PORT=6006

# ===== 上传服务 =====
UPLOAD_ALLOW_ORIGINS=*
UPLOAD_AUTH_TOKEN=
UPLOAD_MAX_FILE_SIZE_MB=25
DASHBOARD_AUTH_TOKEN=
MAX_PIPELINE_QUEUE_SIZE=3

# ===== 流水线触发 =====
MIN_IMG_COUNT=60
STABLE_POLLS=3
POLL_INTERVAL_SEC=4
RETRY_INTERVAL_SEC=15
RUN_ONCE=true
CLEAR_TARGET_BEFORE_RUN=true
ARCHIVE_INPUT=false
CLEAR_INPUT_AFTER_SNAPSHOT=true
MAX_SCENES_KEEP=5
MAX_PHOTO_SETS_KEEP=5

# ===== Spann3R（单卡4090建议）=====
SPANN3R_DEVICE=cuda:0
SPANN3R_CKPT_PATH=./checkpoints/spann3r.pth
SPANN3R_RESOLUTION=224
SPANN3R_KF_EVERY=6
SPANN3R_CONF_THRESH=0.015
SPANN3R_VOXEL_SIZE=0.008
SPANN3R_SAVE_ORI=false

# ===== Nerfstudio =====
TRAIN_SPLIT_FRACTION=0.95
NS_TRAIN_EXTRA_ARGS=
NS_OUTPUT_ROOT=/root/autodl-tmp/Spann3R/outputs
NS_EXPORT_AFTER_TRAIN=true
GAUSSIAN_EXPORT_SUBDIR=gaussian_export
GAUSSIAN_CROP_PADDING_RATIO=0.03
GAUSSIAN_REF_DISTANCE_SCALE=4.0
NS_EXPORT_EXTRA_ARGS=
POINTCLOUD_CACHE_DIR=/root/autodl-tmp/pointcloud_processed_cache
PROCESSED_DOWNLOAD_VOXEL_SIZE=0.02
PROCESSED_DOWNLOAD_PADDING_RATIO=0.03
PROCESSED_DOWNLOAD_MAX_AGE_HOURS=24
PROCESSED_DOWNLOAD_MAX_FILES=12

# ===== 单线程CPU约束 =====
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
